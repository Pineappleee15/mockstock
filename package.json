{
  "name": "mockstock",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:create": "tsx scripts/create-db.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "test": "vitest run",
    "loadtest": "tsx scripts/loadtest.ts",
    "db:migrate": "drizzle-kit migrate",
    "deploy": "node scripts/deploy-init.mjs && next start"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.5",
    "jose": "^6.1.0",
    "next": "15.5.4",
    "papaparse": "^5.5.3",
    "postgres": "^3.4.7",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "recharts": "^2.15.4",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.3.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "dotenv": "^17.2.2",
    "drizzle-kit": "^0.31.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}