# Copy to .env.local for local development. Never commit the real values.

# Local dev uses the vendored Postgres in .tools/ on port 5433.
# On Railway, set this to ${{Postgres.DATABASE_URL}} so it tracks the plugin.
DATABASE_URL=postgres://postgres:mockstock@127.0.0.1:5433/mockstock

# Signs the session cookie. Must be 32+ characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-32-or-more-random-characters

# Used once, on first deploy, to create the admin account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Set to false to stop the price ticker (useful when debugging).
TICKER_ENABLED=true
